{
  "name": "@queueforge/application",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest --config ../../jest.config.cjs --rootDir ."
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/typeorm": "12.0.1",
    "@queueforge/config": "workspace:*",
    "@queueforge/contracts": "workspace:*",
    "@queueforge/domain": "workspace:*",
    "@queueforge/observability": "workspace:*",
    "@queueforge/persistence": "workspace:*",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@types/passport-jwt": "4.0.1"
  }
}
