{
  "name": "@queueforge/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest --config ../../jest.config.cjs --rootDir .",
    "db:migrate": "node dist/cli.js migrate",
    "db:migrate:revert": "node dist/cli.js revert",
    "db:seed": "node dist/cli.js seed"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "@queueforge/config": "workspace:*",
    "@queueforge/contracts": "workspace:*",
    "@queueforge/domain": "workspace:*",
    "argon2": "0.45.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
