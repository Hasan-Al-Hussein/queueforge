{
  "name": "queueforge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multi-tenant workflow automation with durable queues, approvals, and signed webhooks.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "bootstrap": "pnpm -r --if-present build",
    "build": "pnpm bootstrap",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm bootstrap && pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm dev:inner",
    "dev:inner": "concurrently -k -n api,worker,web,sink -c blue,magenta,cyan,yellow \"pnpm --filter @queueforge/api dev\" \"pnpm --filter @queueforge/worker dev\" \"pnpm --filter @queueforge/web dev\" \"pnpm --filter @queueforge/webhook-sink dev\"",
    "dev:services": "docker compose -p queueforge-dev up -d postgres redis",
    "dev:services:down": "docker compose -p queueforge-dev down",
    "test:services": "docker compose -p queueforge-test -f compose.test.yaml up -d --wait",
    "test:services:down": "docker compose -p queueforge-test -f compose.test.yaml down",
    "test:services:reset": "pwsh -NoProfile -File scripts/reset-test-services.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm bootstrap && pnpm lint:inner",
    "lint:inner": "eslint . --max-warnings 0",
    "typecheck": "pnpm bootstrap && pnpm typecheck:inner",
    "typecheck:inner": "pnpm -r --if-present typecheck",
    "test:unit": "pnpm bootstrap && pnpm test:unit:inner",
    "test:unit:inner": "pnpm -r --if-present test:unit",
    "test:web": "pnpm --filter @queueforge/web test",
    "test:integration": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm test:integration:inner",
    "test:integration:inner": "pnpm db:build && pwsh -NoProfile -File scripts/prepare-test-database.ps1 && jest --config tests/integration/jest.config.cjs --runInBand",
    "test:contract": "pnpm --filter @queueforge/contracts test:unit",
    "test:db": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm test:db:inner",
    "test:db:inner": "pnpm db:build && pwsh -NoProfile -File scripts/prepare-test-database.ps1 && jest --config tests/integration/jest.config.cjs --runInBand --testPathPattern=database",
    "test:security": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm test:security:inner",
    "test:security:inner": "pnpm db:build && pwsh -NoProfile -File scripts/prepare-test-database.ps1 && jest --config tests/integration/jest.config.cjs --runInBand --testPathPattern=security",
    "test:a11y": "pnpm --filter @queueforge/web test:a11y",
    "test:e2e": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm test:e2e:inner",
    "test:e2e:inner": "playwright test --config tests/e2e/playwright.config.ts",
    "test:load:smoke": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm test:load:smoke:inner",
    "test:load:smoke:inner": "pwsh -NoProfile -File scripts/run-k6.ps1 -Scenario smoke",
    "test:load:security": "tsx scripts/check-k6-summary-security.ts",
    "k6:install": "pwsh -NoProfile -File scripts/install-k6.ps1",
    "db:build": "pnpm --filter @queueforge/persistence... build",
    "db:migrate": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm db:migrate:inner",
    "db:migrate:inner": "pnpm db:build && pnpm --filter @queueforge/persistence db:migrate",
    "db:migrate:revert": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm db:migrate:revert:inner",
    "db:migrate:revert:inner": "pnpm db:build && pnpm --filter @queueforge/persistence db:migrate:revert",
    "db:seed": "pwsh -NoProfile -File scripts/run-with-env.ps1 corepack pnpm db:seed:inner",
    "db:seed:inner": "pnpm db:build && pnpm --filter @queueforge/persistence db:seed",
    "env:generate": "pwsh -NoProfile -File scripts/generate-env.ps1",
    "evidence:baseline": "pwsh -NoProfile -File scripts/measure-resources.ps1 -CaptureBaseline",
    "evidence:resources": "pwsh -NoProfile -File scripts/measure-resources.ps1",
    "evidence:clean-start": "pwsh -NoProfile -File scripts/verify-clean-start.ps1",
    "evidence:claims": "pwsh -NoProfile -File scripts/verify-claims.ps1",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "audit:secrets": "secretlint \"**/*\" --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore",
    "audit:local": "pnpm audit:deps && pnpm audit:secrets && pnpm test:security && pnpm test:load:security",
    "security:next-gate": "tsx scripts/check-next-security-gate.ts",
    "verify": "pnpm format:check && pnpm bootstrap && pnpm lint:inner && pnpm typecheck:inner && pnpm test:unit:inner",
    "verify:local": "pnpm verify && pnpm test:integration && pnpm test:web",
    "verify:release": "pnpm verify:local && pnpm test:a11y && pnpm test:e2e && pnpm test:load:smoke && pnpm audit:local && pnpm security:next-gate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.2",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
