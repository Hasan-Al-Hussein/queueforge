{
  "name": "@queueforge/demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remotion bundle src/index.ts --out-dir dist",
    "captions": "tsx scripts/write-srt.ts",
    "compositions": "remotion compositions src/index.ts",
    "finalize": "powershell -NoProfile -ExecutionPolicy Bypass -File ../recording/finalize-video.ps1",
    "poster": "remotion still src/index.ts QueueForgePoster ../output/product-demo-poster.png --frame 0",
    "render": "remotion render src/index.ts QueueForgeProductDemo ../output/intermediate/product-demo-remotion-raw.mp4 --codec h264 --pixel-format yuv420p --audio-codec aac --crf 20",
    "render:release": "pnpm captions && pnpm render && pnpm finalize",
    "stills": "tsx scripts/render-stills.ts",
    "studio": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-render.ts"
  },
  "dependencies": {
    "@remotion/captions": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/fonts": "4.0.518",
    "@remotion/media": "4.0.518",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
