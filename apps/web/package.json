    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "serve": "14.2.6",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
